{
    "name": "dwarfdk/laravel-meilitools",
    "description": "Additional tools for Laravel Scout integration with MeiliSearch",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "scout",
        "meili",
        "meilisearch",
        "meilitools"
    ],
    "authors": [
        {
            "name": "Frederik Sauer",
            "email": "fsa@dwarf.dk"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^12.22 || ^13.0",
        "illuminate/support": "^12.22 || ^13.0",
        "illuminate/validation": "^12.22 || ^13.0",
        "laravel/scout": "^10.24 || ^11.0",
        "meilisearch/meilisearch-php": "^1.17"
    },
    "require-dev": {
        "brick/varexporter": "^0.7",
        "driftingly/rector-laravel": "^2.6.2",
        "ergebnis/composer-normalize": "^2.54",
        "guzzlehttp/guzzle": "^7.10",
        "http-interop/http-factory-guzzle": "^1.2",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.10.3",
        "laravel/pint": "^1.32.1",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.7.8 || ^5.3.0",
        "pestphp/pest-plugin-rector": "^5.0.5",
        "pestphp/pest-plugin-type-coverage": "^4.0.4 || ^5.0.2",
        "rector/rector": "^2.7"
    },
    "suggest": {
        "brick/varexporter": "Improves readability of console output for index details"
    },
    "autoload": {
        "psr-4": {
            "Dwarf\\MeiliTools\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dwarf\\MeiliTools\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        },
        "audit": {
            "ignore-abandoned": [
                "symplify/rule-doc-generator-contracts"
            ]
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dwarf\\MeiliTools\\MeiliToolsServiceProvider"
            ]
        }
    },
    "scripts": {
        "boost:update": [
            "@php -r \"require 'vendor/autoload.php'; (new Illuminate\\\\Filesystem\\\\Filesystem())->copy('boost.json', 'vendor/orchestra/testbench-core/laravel/boost.json'); (new Illuminate\\\\Filesystem\\\\Filesystem())->copyDirectory('.ai', 'vendor/orchestra/testbench-core/laravel/.ai');\"",
            "testbench boost:update"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@security:check",
            "@test"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "normalize:check": [
            "@composer normalize --dry-run"
        ],
        "rector": [
            "rector process --dry-run"
        ],
        "rector:fix": [
            "rector process"
        ],
        "security:check": [
            "@composer audit"
        ],
        "test": [
            "@normalize:check",
            "@rector",
            "@lint:check",
            "@types:check",
            "@type-coverage",
            "pest"
        ],
        "test:coverage": [
            "pest --coverage"
        ],
        "type-coverage": [
            "pest --type-coverage --min=100"
        ],
        "types:check": [
            "phpstan analyse"
        ]
    }
}
